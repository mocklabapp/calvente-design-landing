---
import type { PublishedPage } from '@/i18n/pages';
import { profileCopy } from './copy';
import ProfilePortrait from './ProfilePortrait.astro';

interface Props { page: PublishedPage }
const { page } = Astro.props;
const copy = profileCopy[page.locale];
---
<div class="wrap">
  <div class="au">
    <div class="intro">
      <div class="text">
        <div class="up">{copy.label}</div>
        <h1>{copy.name}</h1>
        <div class="bio">
          {copy.bio.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
    </div>
    <ProfilePortrait label={copy.portraitLabel} caption={copy.portraitPending} />
  </div>
</div>

<style>
  .au {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: 56px;
    padding-block: 24px 0;
    min-height: 70vh;
  }
  .intro {
    display: flex;
    flex-direction: column;
  }
  .text {
    margin-block: auto;
    display: grid;
    gap: 22px;
  }
  h1 {
    font-size: clamp(34px, 4.4vw, 54px);
    line-height: 1.05;
  }
  .bio {
    display: grid;
    gap: 12px;
    max-width: 54ch;
    font-size: 12.5px;
  }
  @media (max-width: 860px) {
    .au {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
</style>
