---
import type { ProjectsCopy } from './copy';
import { pad } from './present';

interface Props {
  copy: ProjectsCopy;
  count: number;
}

const { copy, count } = Astro.props;
const index = Array.from({ length: count }, (_, i) => pad(i + 1)).join('  ');
---
<div class="regfoot">
  <div>{copy.notes}<br />—</div>
  <div class="idx">{copy.index}<br />{index}</div>
  <div>{copy.photography}<br />{copy.photographyCredit}</div>
</div>

<style>
  .regfoot {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    padding-inline: 4%;
    margin-top: 64px;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .regfoot > div {
    border-top: 1px solid var(--color-line);
    padding-top: 10px;
  }
  .idx {
    white-space: pre-wrap;
  }
  @media (max-width: 860px) {
    .regfoot {
      grid-template-columns: 1fr;
      gap: 10px;
      padding-inline: 0;
    }
  }
</style>
