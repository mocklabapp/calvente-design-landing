---
import { getProjectCategoryLabel, type ProjectCategoryId } from '@/lib/project-categories';
import type { Locale } from '@/i18n/locales';
import type { ProjectsCopy } from './copy';
import { pad } from './present';

interface Props {
  locale: Locale;
  copy: ProjectsCopy;
  /** Listing path; chips are plain links so filtering needs no client JavaScript. */
  basePath: string;
  categories: ProjectCategoryId[];
  active: ProjectCategoryId | null;
  shown: number;
}

const { locale, copy, basePath, categories, active, shown } = Astro.props;
const works = shown === 1 ? copy.worksOne : copy.worksMany;
---
<div class="fbar">
  <nav class="grp" aria-label={copy.filterLabel}>
    <b>{copy.category}</b>
    <a class="chip" href={basePath} aria-current={active === null ? 'true' : undefined}>{copy.all}</a>
    {categories.map((id) => (
      <a class="chip" href={`${basePath}?category=${id}`} aria-current={active === id ? 'true' : undefined}>
        {getProjectCategoryLabel(id, locale)}
      </a>
    ))}
  </nav>
  <div class="end num">{pad(shown)} {works}</div>
</div>

<style>
  .fbar {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    align-items: center;
    padding-block: 12px;
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    margin-bottom: 28px;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .grp {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
    align-items: center;
  }
  b {
    font-weight: 500;
  }
  .chip {
    padding-block: 2px;
    border-bottom: 1px solid transparent;
    color: var(--color-muted);
  }
  .chip[aria-current='true'] {
    color: var(--color-ink);
    border-color: var(--color-ink);
  }
  .chip:hover {
    color: var(--color-ink);
  }
  .end {
    margin-left: auto;
    display: flex;
    gap: 14px;
    align-items: center;
    font-variant-numeric: tabular-nums;
  }
</style>
