---
import type { ProjectImage } from '@/lib/project-images';
import { fill, type ProjectsCopy } from './copy';
import ProjectPhoto from './ProjectPhoto.astro';

interface Props {
  copy: ProjectsCopy;
  title: string;
  images: ProjectImage[];
}

const { copy, title, images } = Astro.props;
const label = fill(copy.galleryLabel, { title });
---
{images.length === 0 ? (
  <div class="none"><ProjectPhoto emptyLabel={copy.noImages} ratio="4/3" /></div>
) : (
  <>
    <div class="pd-gal" data-gallery>
      {images.map((image, index) => (
        <button type="button" class="zoom" data-index={index} data-src={image.url}
          aria-label={fill(copy.openImage, { n: index + 1 })} aria-haspopup="dialog">
          <ProjectPhoto src={image.url} loading={index === 0 ? 'eager' : 'lazy'} emptyLabel={copy.noImages} />
        </button>
      ))}
    </div>
    <div class="lb" role="dialog" aria-modal="true" aria-label={label} hidden data-lightbox>
      <img alt="" src="data:," />
      <button type="button" class="lb-nav l" data-step="-1" aria-label={copy.lightboxPrevious}>‹</button>
      <button type="button" class="lb-nav r" data-step="1" aria-label={copy.lightboxNext}>›</button>
      <button type="button" class="lb-x" data-close aria-label={copy.lightboxClose}>×</button>
      <span class="lb-n" aria-live="polite" data-counter></span>
    </div>
  </>
)}

<style>
  .pd-gal {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 12px;
  }
  .zoom {
    position: relative;
    display: block;
    cursor: zoom-in;
    grid-column: span 2;
    aspect-ratio: 4 / 5;
  }
  .zoom :global(.ph) {
    position: absolute;
    inset: 0;
  }
  .zoom:nth-child(1) {
    grid-column: span 4;
    aspect-ratio: 4 / 3;
  }
  .zoom:nth-child(2) {
    aspect-ratio: auto;
  }
  @media (max-width: 860px) {
    .zoom:nth-child(n) {
      grid-column: span 6;
      aspect-ratio: 4 / 3;
    }
  }

  .lb {
    position: fixed;
    inset: 0;
    z-index: 95;
    background: var(--color-lightbox-backdrop);
    backdrop-filter: blur(3px);
    display: grid;
    place-items: center;
    padding:
      calc(4vh + env(safe-area-inset-top, 0px))
      max(72px, calc(env(safe-area-inset-right, 0px) + 64px))
      calc(4vh + env(safe-area-inset-bottom, 0px))
      max(72px, calc(env(safe-area-inset-left, 0px) + 64px));
  }
  .lb[hidden] {
    display: none;
  }
  .lb img {
    max-width: 100%;
    max-height: 88vh;
    object-fit: contain;
    box-shadow: 0 18px 60px var(--color-lightbox-shadow);
    cursor: default;
  }
  .lb-nav,
  .lb-x {
    position: absolute;
    display: grid;
    place-items: center;
    background: var(--color-lightbox-control);
    color: var(--color-on-lightbox-control);
    border: 0;
  }
  .lb-nav[hidden] {
    display: none;
  }
  .lb-nav {
    top: 50%;
    transform: translateY(-50%);
    width: 48px;
    height: 48px;
    font-size: 26px;
    line-height: 1;
  }
  .lb-nav.l {
    left: max(14px, env(safe-area-inset-left, 0px));
  }
  .lb-nav.r {
    right: max(14px, env(safe-area-inset-right, 0px));
  }
  .lb-x {
    top: calc(14px + env(safe-area-inset-top, 0px));
    right: max(14px, env(safe-area-inset-right, 0px));
    width: 40px;
    height: 40px;
    font-size: 22px;
  }
  .lb-nav:hover,
  .lb-x:hover {
    background: var(--color-lightbox-control-hover);
  }
  .lb-n {
    position: absolute;
    bottom: calc(14px + env(safe-area-inset-bottom, 0px));
    left: 50%;
    transform: translateX(-50%);
    color: var(--color-on-photo);
    font-size: 11.5px;
    letter-spacing: 0.06em;
    font-variant-numeric: tabular-nums;
    text-shadow: 0 1px 4px var(--color-lightbox-shadow);
  }
  @media (max-width: 620px) {
    .lb {
      padding-inline: 12px;
    }
    .lb-nav {
      top: auto;
      bottom: calc(12px + env(safe-area-inset-bottom, 0px));
      transform: none;
      width: 44px;
      height: 44px;
    }
  }
</style>

<script>
  import { initLightbox } from './lightbox';

  initLightbox();
</script>
