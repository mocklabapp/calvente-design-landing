---
import type { ProjectsCopy } from './copy';
import { safeWebLink, type ProjectView } from './present';

interface Props {
  copy: ProjectsCopy;
  view: ProjectView;
}

const { copy, view } = Astro.props;
const { project, categoryLabel } = view;
const web = safeWebLink(project.weblink);
---
<div class="spec">
  {categoryLabel && (<><div>{copy.category}</div><div>{categoryLabel}</div></>)}
  {project.year && (<><div>{copy.year}</div><div>{project.year}</div></>)}
  {web && (
    <>
      <div>{copy.website}</div>
      <div><a class="lnk" href={web.href} rel="noopener noreferrer" target="_blank"
        aria-label={`${copy.visitWebsite}: ${web.label}`}>{web.label}</a></div>
    </>
  )}
</div>

<style>
  .spec {
    display: grid;
    grid-template-columns: 150px 1fr;
    font-size: 11.5px;
    border-top: 1px solid var(--color-ink);
  }
  .spec > div {
    padding: 9px 0;
    border-bottom: 1px solid var(--color-line);
    overflow-wrap: anywhere;
  }
  .spec > div:nth-child(odd) {
    font-size: 10.5px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  @media (max-width: 520px) {
    .spec {
      grid-template-columns: 110px 1fr;
    }
  }
</style>
