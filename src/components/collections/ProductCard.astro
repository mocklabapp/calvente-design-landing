---
import type { Locale } from '@/i18n/locales';
import { childPath } from '@/i18n/routes';
import type { Product } from '@/lib/products';
import Tile from '@/components/ui/Tile.astro';
import { categoryOf } from './catalog';

interface Props {
  product: Product;
  locale: Locale;
}
const { product, locale } = Astro.props;
const href = childPath('collections', locale, product.id);
if (href === undefined) throw new Error(`[collections] No published listing for ${locale}.`);
---
<a href={href} data-category={product.category} data-group={categoryOf(product).group}>
  <Tile src={product.images[0]} ratio="4/5" widths={[320, 480, 640]}
    sizes="(max-width: 520px) 50vw, (max-width: 1100px) 33vw, 25vw" />
  <div class="meta">
    <b>{product.name}</b>
    <span class="d">{product.short[locale]} · {product.sizes[0]![locale]}</span>
  </div>
</a>

<style>
  .meta {
    padding-top: 10px;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2px 10px;
  }
  b {
    font-weight: 500;
  }
  .d {
    grid-column: 1 / -1;
    color: var(--color-muted);
    font-size: 11.5px;
  }
</style>
