---
import { Image } from 'astro:assets';
import Tile from '@/components/ui/Tile.astro';
import type { Locale } from '@/i18n/locales';
import { getLocalImage } from '@/lib/images';
import type { Product } from '@/lib/products';
import { copy, fill } from './copy';

interface Props {
  product: Product;
  locale: Locale;
}
const { product, locale } = Astro.props;
const labels = copy[locale];
const total = product.images.length;
---
<div data-gallery>
  <div class="main">
    {product.images.map((name, index) => (
      <div data-view-panel hidden={index > 0}>
        <Tile src={name} fit="contain" ratio="4/5" loading={index === 0 ? 'eager' : 'lazy'}
          alt={`${product.name} · ${fill(labels.viewLabel, { n: index + 1 })}`}
          widths={[480, 720, 960]} sizes="(max-width: 860px) 100vw, 50vw" />
      </div>
    ))}
  </div>
  <div class="thumbs">
    <div class="buttons" role="group" aria-label={labels.views}>
      {product.images.map((name, index) => (
        <button type="button" data-view-button aria-pressed={index === 0 ? 'true' : 'false'}
          aria-label={fill(labels.viewLabel, { n: index + 1 })}>
          <Image src={getLocalImage(name)} alt="" width={116} height={116} loading="lazy" decoding="async" />
        </button>
      ))}
    </div>
    <span class="v up num" aria-live="polite" data-view-count data-template={labels.viewCount}
      data-total={total}>{fill(labels.viewCount, { n: 1, total })}</span>
  </div>
</div>

<style>
  .main {
    background: var(--color-tile);
  }
  .thumbs {
    display: flex;
    gap: 8px;
    margin-top: 8px;
    align-items: center;
  }
  .buttons {
    display: flex;
    gap: 8px;
  }
  button {
    width: 58px;
    aspect-ratio: 1;
    opacity: 0.55;
    border: 1px solid transparent;
    background: var(--color-tile);
    overflow: hidden;
  }
  button[aria-pressed='true'] {
    opacity: 1;
    border-color: var(--color-ink);
  }
  button :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .v {
    margin-left: auto;
  }
</style>

<script>
  // Switches the main view; without JS the first view is shown.
  for (const gallery of document.querySelectorAll<HTMLElement>('[data-gallery]')) {
    const panels = [...gallery.querySelectorAll<HTMLElement>('[data-view-panel]')];
    const buttons = [...gallery.querySelectorAll<HTMLButtonElement>('[data-view-button]')];
    const counter = gallery.querySelector<HTMLElement>('[data-view-count]');

    buttons.forEach((button, index) => {
      button.addEventListener('click', () => {
        panels.forEach((panel, other) => { panel.hidden = other !== index; });
        buttons.forEach((other) => other.setAttribute('aria-pressed', String(other === button)));
        if (counter) {
          counter.textContent = (counter.dataset.template ?? '')
            .replace('{n}', String(index + 1))
            .replace('{total}', counter.dataset.total ?? String(panels.length));
        }
      });
    });
  }
</script>
