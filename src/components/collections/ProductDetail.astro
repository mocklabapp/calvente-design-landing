---
import type { Locale } from '@/i18n/locales';
import { pathFor } from '@/i18n/routes';
import { ui } from '@/i18n/ui';
import type { Product } from '@/lib/products';
import { categoryOf } from './catalog';
import { copy } from './copy';
import ProductGallery from './ProductGallery.astro';

interface Props {
  product: Product;
  locale: Locale;
}
const { product, locale } = Astro.props;
const labels = copy[locale];
const listing = pathFor('collections', locale);
const contact = pathFor('contact', locale);
if (listing === undefined || contact === undefined) {
  throw new Error(`[collections] Missing published listing or contact page for ${locale}.`);
}
---
<div class="pp">
  <div class="l">
    <a class="up" href={listing}>⟵ {ui[locale].nav.collections}</a>
    <h1><small>{categoryOf(product).label[locale]}</small>{product.name}</h1>
    <div class="desc"><p>{product.description[locale]}</p></div>
    <dl class="dims">
      <dt>{labels.dimensions}</dt>
      <dd>{product.sizes.map((size) => <span>{size[locale]}</span>)}</dd>
      <dt>{labels.height}</dt>
      <dd>{product.height}</dd>
      <dt>{labels.weight}</dt>
      <dd>{product.weight}</dd>
    </dl>
    <div class="order">
      <div class="up">{labels.madeToOrder}</div>
      <div class="fine text-muted">{labels.madeToOrderNote}</div>
      <a class="btn btn-solid cta" href={contact}>{labels.availability}</a>
    </div>
  </div>
  <div class="r">
    <div class="meta2">
      <div>{labels.collection}:<br />{labels.brand}</div>
      <div>{labels.reference}<br />{product.code}</div>
    </div>
    <ProductGallery product={product} locale={locale} />
  </div>
</div>

<style>
  .pp {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: 56px;
    padding-block: 44px 0;
  }
  .l {
    display: flex;
    flex-direction: column;
    gap: 28px;
    position: sticky;
    top: 110px;
    align-self: start;
  }
  h1 {
    font-size: clamp(34px, 4.6vw, 60px);
    line-height: 0.98;
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }
  h1 small {
    display: block;
    font-size: 0.42em;
    letter-spacing: 0.02em;
    margin-bottom: 6px;
  }
  .desc {
    max-width: 52ch;
    display: grid;
    gap: 10px;
  }
  .dims {
    display: grid;
    grid-template-columns: 90px 1fr;
    gap: 2px 16px;
    font-size: 12px;
    margin: 0;
  }
  .dims dd {
    margin: 0;
  }
  .dims span {
    display: block;
  }
  .order {
    border-top: 1px solid var(--color-brand);
    padding-top: 12px;
    display: grid;
    gap: 10px;
  }
  .cta {
    margin-top: 6px;
    justify-self: start;
  }
  .meta2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    font-size: 11.5px;
    margin-bottom: 20px;
  }
  @media (max-width: 860px) {
    .pp {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .l {
      position: static;
    }
  }
</style>
