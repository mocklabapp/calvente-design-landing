---
import type { Locale } from '@/i18n/locales';
import { products } from './catalog';
import { copy } from './copy';
import FilterBar from './FilterBar.astro';
import ProductCard from './ProductCard.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
---
<div data-product-filter>
  <FilterBar locale={locale} />
  <div class="gA">
    {products.map((product) => <ProductCard product={product} locale={locale} />)}
  </div>
  <p class="empty text-muted" data-empty hidden>{copy[locale].empty}</p>
</div>

<style>
  .gA {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 36px 14px;
  }
  .empty {
    padding-block: 40px;
  }
  @media (max-width: 1100px) {
    .gA {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 860px) {
    .gA {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 520px) {
    .gA {
      gap: 28px 10px;
    }
  }
</style>

<script>
  // Progressive filter: without JS every product stays visible.
  for (const root of document.querySelectorAll<HTMLElement>('[data-product-filter]')) {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('button[data-filter]')];
    const cards = [...root.querySelectorAll<HTMLElement>('a[data-category]')];
    const count = root.querySelector<HTMLElement>('[data-count]');
    const empty = root.querySelector<HTMLElement>('[data-empty]');

    const matches = (card: HTMLElement, filter: string): boolean =>
      filter === 'all' || filter === card.dataset.category || filter === `g-${card.dataset.group}`;

    for (const button of buttons) {
      button.addEventListener('click', () => {
        const filter = button.dataset.filter ?? 'all';
        let visible = 0;
        for (const card of cards) {
          const show = matches(card, filter);
          card.hidden = !show;
          if (show) visible += 1;
        }
        for (const other of buttons) other.setAttribute('aria-pressed', String(other === button));
        if (count) count.textContent = String(visible);
        if (empty) empty.hidden = visible > 0;
      });
    }
  }
</script>
