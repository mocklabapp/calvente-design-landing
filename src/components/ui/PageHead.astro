---
interface Props {
  title: string;
  intro: string;
}

const { title, intro } = Astro.props;
---
<div class="phead">
  <h1>{title}</h1>
  <p>{intro}</p>
</div>

<style>
  .phead {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    align-items: end;
    padding-block: 56px 28px;
  }
  h1 {
    font-size: clamp(30px, 4.2vw, 52px);
    line-height: 1.02;
    letter-spacing: -0.01em;
  }
  p {
    max-width: 56ch;
  }
  @media (max-width: 860px) {
    .phead {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
</style>
