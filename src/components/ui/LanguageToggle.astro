---
import { locales, type Locale } from '@/i18n/locales';
import type { Alternate } from '@/i18n/routes';
import { ui } from '@/i18n/ui';

interface Props {
  locale: Locale;
  /** Published equivalents of the current page; the toggle hides without an alternative. */
  alternates: Alternate[];
}

const { locale, alternates } = Astro.props;
---
{alternates.length > 1 && (
  <nav class="lang" aria-label={ui[locale].languageNavigation}>
    {alternates.map((alternate, index) => (
      <>
        {index > 0 && ' / '}
        <a
          href={alternate.path}
          lang={locales[alternate.locale].lang}
          hreflang={locales[alternate.locale].lang}
          aria-label={locales[alternate.locale].label}
          aria-current={alternate.locale === locale ? 'page' : undefined}
        >{locales[alternate.locale].lang.toUpperCase()}</a>
      </>
    ))}
  </nav>
)}

<style>
  .lang {
    display: inline;
  }
  a[aria-current='page'] {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  a:hover {
    opacity: 0.7;
  }
</style>
